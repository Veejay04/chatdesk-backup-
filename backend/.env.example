# Django
SECRET_KEY=chatdeskdevelopment
DEBUG=True
# Add your machine's LAN IP here too (e.g. 192.168.1.X) if you're testing
# against the mobile app on a physical device/emulator - otherwise every
# request from your phone gets rejected with DisallowedHost before it even
# reaches your views.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local dev) - see claude/ENV_GUIDE.md for who to get these from
DB_NAME=chatdesk_db
DB_USER=chatdesk_user
DB_PASSWORD=chatdesk123
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes - already sane defaults per claude/ENV_GUIDE.md, only change if the backend team agrees
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# CORS - comma separated origins allowed to call this API (web dev server + mobile dev tunnel)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# OpenAI - CRITICAL: this must only ever exist in backend/.env, never in web/.env or mobile/.env
OPENAI_API_KEY=sk-replace-with-real-key

# Gmail SMTP - sends the password reset code and registration verification
# link. Optional for local dev: if left blank AND DEBUG=True, the code/link is
# returned in the API response instead (dev_code / dev_verify_url). With
# DEBUG=False nothing is ever returned - set a real App Password there.
# Needs a Gmail App Password (not the account's normal password) from a Gmail
# account with 2-Step Verification on - myaccount.google.com/apppasswords.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional. Base address put in verification-email links. Blank = the address
# the request came in on (usually your LAN IP, which only works on the same
# Wi-Fi). e.g. https://chatdesk.example.edu
PUBLIC_BASE_URL=

# Optional registration gates, both off by default.
# ALLOWED_EMAIL_DOMAINS: comma-separated, e.g. ustp.edu.ph - blank = any email.
# REQUIRE_EMAIL_VERIFICATION: True blocks student login until the emailed link is clicked.
ALLOWED_EMAIL_DOMAINS=
REQUIRE_EMAIL_VERIFICATION=False
